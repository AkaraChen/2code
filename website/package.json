{
  "name": "2code-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/emit-blog-markdown.mjs",
    "build:drafts": "BLOG_INCLUDE_DRAFTS=1 bun run build",
    "build:scheduled": "BLOG_INCLUDE_SCHEDULED=1 bun run build",
    "lint": "eslint .",
    "preview": "python3 -m http.server 3000 -d out"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grab": "^0.1.44",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
